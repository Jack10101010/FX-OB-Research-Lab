# Scratch validation harnesses (prevent re-accumulation)
/frontend/_*.mjs
/frontend/_*.cjs
/frontend/be_debug.mjs
/frontend/be_sanity.mjs
/frontend/src/_*.mjs
/frontend/src/data/__validation__/_*.mjs

# Research archive — scratch/triage buckets stay out of git; the curated
# buckets (_research/{audits,plans,investigations,handoffs}) are committed.
/_research/exports/
/_research/_unsorted/

# macOS metadata
._*

# FUSE temp files
.fuse_hidden*
